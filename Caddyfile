camcam.smarbiz.sbs {
    encode zstd gzip

    @internal path /internal/*
    respond @internal 404

    @api path /api/*
    header @api Cache-Control "no-store, max-age=0"

    # Stable same-site APK URL. The binary is the signed internal install APK
    # published by CamCam's own GitHub Actions release workflow over HTTPS.
    handle /download/CamCam.apk {
        header Cache-Control "no-store, max-age=0"
        header X-Content-Type-Options "nosniff"
        redir https://github.com/hsdarestani/cacmcam/releases/latest/download/CamCam-Test.apk 302
    }

    # Canonical static assets. Historical Android URLs are thin aliases only.
    handle /sw.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Service-Worker-Allowed "/"
        root * /srv/camcam-web
        rewrite * /sw.js
        file_server
    }

    handle /static/sw.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Service-Worker-Allowed "/"
        root * /srv/camcam-web
        rewrite * /sw.js
        file_server
    }

    @viewer_alias path /static/pet_controls_hotfix.js /static/pet_controls_bundle.js /static/pet_controls_bundle_v2.js /static/pet_runtime_fix.js /static/pet_runtime_v2.js /static/pet_runtime_v3.js /static/pet_runtime_v4.js /static/pet_runtime_v5.js
    handle @viewer_alias {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header X-CamCam-Asset "pet-runtime-alias-vnext"
        root * /srv/camcam-web
        rewrite * /pet_compat.js
        file_server
    }

    @camera_alias path /static/pet_camera_hotfix.js /static/pet_camera_bundle.js /static/pet_camera_bundle_v2.js /static/pet_camera_runtime_v2.js /static/pet_camera_runtime_v3.js /static/pet_camera_runtime_v4.js /static/pet_camera_runtime_v5.js
    handle @camera_alias {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header X-CamCam-Asset "camera-runtime-alias-vnext"
        root * /srv/camcam-web
        rewrite * /pet_camera_compat.js
        file_server
    }

    # Canonical assets are content-versioned in the HTML. Cache them at the
    # edge and in Android WebView so reopening the app never re-downloads the
    # complete runtime over a slow origin connection.
    @immutable_assets path /static/pet_runtime.js /static/pet_ui.js /static/pet_camera_runtime.js /static/pet_camera_ui.js /static/fonts/* /static/audio/*
    handle @immutable_assets {
        header Cache-Control "public, max-age=31536000, immutable"
        header CDN-Cache-Control "public, max-age=31536000, immutable"
        header Cloudflare-CDN-Cache-Control "public, max-age=31536000, immutable"
        header X-CamCam-Asset "canonical-v20260912-3"
        root * /srv/camcam-web
        uri strip_prefix /static
        file_server
    }

    handle /static/* {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header CDN-Cache-Control "no-store"
        header Cloudflare-CDN-Cache-Control "no-store"
        root * /srv/camcam-web
        uri strip_prefix /static
        file_server
    }

    # One-time repair URL. Clear-Site-Data tells Chromium to evict CacheStorage
    # and old service-worker registrations at the HTTP layer; reset.html also
    # replaces the currently controlling worker before navigating back to /.
    handle /refresh {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Clear-Site-Data "\"cache\", \"storage\""
        header X-CamCam-Page "cache-repair-v3"
        root * /srv/camcam-web
        rewrite * /reset.html
        file_server
    }

    # Versioned public landing route deliberately avoids the historically
    # cached root URL and is useful as a guaranteed fresh entrypoint.
    handle /landing {
        header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header X-CamCam-Page "landing-vnext"
        root * /srv/camcam-web
        rewrite * /landing.html
        file_server
    }

    # Dynamic Pet routes must be matched before the static /pet entrypoint.
    @pet_recordings path_regexp pet_recordings ^/api/pet/devices/[^/]+/recordings$
    handle @pet_recordings {
        reverse_proxy petarchive:8030
    }

    @pet_manual path_regexp pet_manual ^/api/pet/devices/[^/]+/manual-recordings($|/start$|/[^/]+/stop$)
    handle @pet_manual {
        reverse_proxy petarchive:8030
    }

    @pet_talk_wake path_regexp pet_talk_wake ^/api/pet/devices/[^/]+/talk-wake$
    handle @pet_talk_wake {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/device/talk-wait {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/* {
        reverse_proxy pet:8020
    }

    handle /pet-archive/* {
        reverse_proxy petarchive:8030
    }

    # Historical event-highlight links still use /archive. Route them through
    # the same authenticated, codec-compatible Pet archive gateway.
    handle /archive/* {
        uri replace /archive /pet-archive
        reverse_proxy petarchive:8030
    }

    # Keep the legacy recording index available for older cached clients.
    @legacy_recordings path_regexp legacy_recording_list ^/api/devices/[^/]+/recordings$
    handle @legacy_recordings {
        reverse_proxy archive:8010
    }

    handle_path /webrtc/* {
        reverse_proxy mediamtx:8889
    }

    # Product HTML entrypoints stay fresh while versioned canonical assets remain
    # cached. Cache eviction is intentionally limited to the explicit /refresh route.
    handle /pet {
        header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header Cloudflare-CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header X-CamCam-Page "pet-vnext"
        root * /srv/camcam-web
        rewrite * /pet.html
        file_server
    }

    # Existing Android builds still open /. Match only CamCam's explicit native
    # user-agent token; normal Chrome/Firefox/Safari must never enter the app UI.
    @android_viewer_root {
        path /
        header_regexp camcam_android_ua User-Agent (?i)CamCamAndroid/[0-9.]+
    }
    handle @android_viewer_root {
        header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header X-CamCam-Page "pet-vnext"
        root * /srv/camcam-web
        rewrite * /pet.html
        file_server
    }

    # Public browser root is always the marketing/download landing page.
    handle / {
        header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header X-CamCam-Page "landing-vnext"
        root * /srv/camcam-web
        rewrite * /landing.html
        file_server
    }

    handle /camera {
        header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header CDN-Cache-Control "public, max-age=300, stale-while-revalidate=86400"
        header X-CamCam-Page "camera-vnext"
        root * /srv/camcam-web
        rewrite * /pet_camera.html
        file_server
    }

    handle {
        reverse_proxy api:8000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    }
}
