camcam.smarbiz.sbs {
    encode zstd gzip

    @internal path /internal/*
    respond @internal 404

    @api path /api/*
    header @api Cache-Control "no-store, max-age=0"

    # Stable same-site APK URL. The binary is the signed internal install APK
    # published by CamCam's own GitHub Actions release workflow over HTTPS.
    handle /download/CamCam.apk {
        header Cache-Control "no-store, max-age=0"
        header X-Content-Type-Options "nosniff"
        redir https://github.com/hsdarestani/cacmcam/releases/latest/download/CamCam-Test.apk 302
    }

    # Retire any legacy service worker that used to control/cache the public
    # root. Both historical script URLs now return the cache-reset worker.
    handle /sw.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Service-Worker-Allowed "/"
        root * /srv/camcam-web
        rewrite * /sw.js
        file_server
    }

    handle /static/sw.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Service-Worker-Allowed "/"
        root * /srv/camcam-web
        rewrite * /sw.js
        file_server
    }

    # pet.html in already-installed APKs references this historical script URL.
    # Serve a tiny bundle loader there so reliability fixes can ship instantly
    # without requiring stale HTML or old WebViews to refresh their markup.
    handle /static/pet_controls_hotfix.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_controls_bundle.js
        file_server
    }

    # Keep the existing visual control-center layer available under a stable
    # internal alias; the bundle loads it first, then the runtime reliability fix.
    handle /static/pet_controls_visual.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_controls_hotfix.js
        file_server
    }

    handle /static/pet_runtime_fix.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_runtime_fix.js
        file_server
    }

    handle /static/pet_runtime_v2.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_runtime_v2.js
        file_server
    }

    # The camera page also keeps the historical hotfix URL. Route it through a
    # bundle so the control plane can stay alive even when WebRTC video retries.
    handle /static/pet_camera_hotfix.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_camera_bundle.js
        file_server
    }

    handle /static/pet_camera_visual.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_camera_hotfix.js
        file_server
    }

    handle /static/pet_camera_runtime_v2.js {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        root * /srv/camcam-web
        rewrite * /pet_camera_runtime_v2.js
        file_server
    }

    # One-time repair URL. Clear-Site-Data tells Chromium to evict CacheStorage
    # and old service-worker registrations at the HTTP layer; reset.html also
    # replaces the currently controlling worker before navigating back to /.
    handle /refresh {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Clear-Site-Data "\"cache\", \"storage\""
        header X-CamCam-Page "cache-repair-v3"
        root * /srv/camcam-web
        rewrite * /reset.html
        file_server
    }

    # Versioned public landing route deliberately avoids the historically
    # cached root URL and is useful as a guaranteed fresh entrypoint.
    handle /landing {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        header X-CamCam-Page "landing-v4"
        root * /srv/camcam-web
        rewrite * /landing.html
        file_server
    }

    # Dynamic Pet routes must be matched before the static /pet entrypoint.
    @pet_recordings path_regexp pet_recordings ^/api/pet/devices/[^/]+/recordings$
    handle @pet_recordings {
        reverse_proxy petarchive:8030
    }

    @pet_manual path_regexp pet_manual ^/api/pet/devices/[^/]+/manual-recordings($|/start$|/[^/]+/stop$)
    handle @pet_manual {
        reverse_proxy petarchive:8030
    }

    @pet_talk_wake path_regexp pet_talk_wake ^/api/pet/devices/[^/]+/talk-wake$
    handle @pet_talk_wake {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/device/talk-wait {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/* {
        reverse_proxy pet:8020
    }

    handle /pet-archive/* {
        reverse_proxy petarchive:8030
    }

    # Historical event-highlight links still use /archive. Route them through
    # the same authenticated, codec-compatible Pet archive gateway.
    handle /archive/* {
        uri replace /archive /pet-archive
        reverse_proxy petarchive:8030
    }

    # Keep the legacy recording index available for older cached clients.
    @legacy_recordings path_regexp legacy_recording_list ^/api/devices/[^/]+/recordings$
    handle @legacy_recordings {
        reverse_proxy archive:8010
    }

    handle_path /webrtc/* {
        reverse_proxy mediamtx:8889
    }

    # Product HTML entrypoints. /pet is deliberately exact: the old /pet*
    # matcher swallowed /pet-archive/* and sent playback clicks to dashboard.
    handle /pet {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        header X-CamCam-Page "pet"
        root * /srv/camcam-web
        rewrite * /pet.html
        file_server
    }

    # Existing Android builds still open /. Match only CamCam's explicit native
    # user-agent token; normal Chrome/Firefox/Safari must never enter the app UI.
    @android_viewer_root {
        path /
        header_regexp camcam_android_ua User-Agent (?i)CamCamAndroid/[0-9.]+
    }
    handle @android_viewer_root {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        header X-CamCam-Page "pet-android"
        root * /srv/camcam-web
        rewrite * /pet.html
        file_server
    }

    # Public browser root is always the marketing/download landing page.
    handle / {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        header X-CamCam-Page "landing-v4"
        root * /srv/camcam-web
        rewrite * /landing.html
        file_server
    }

    handle /camera {
        header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        root * /srv/camcam-web
        rewrite * /pet_camera.html
        file_server
    }

    handle {
        reverse_proxy api:8000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    }
}
