camcam.smarbiz.sbs {
    encode zstd gzip

    @internal path /internal/*
    respond @internal 404

    @api path /api/*
    header @api Cache-Control "no-store, max-age=0"

    # HTML entry points must never be edge/browser cached while the product UI
    # is being served dynamically. /pet is also a fresh canonical path that
    # bypasses any previously cached legacy response for '/'.
    @html_entries path / /pet /pet/ /camera
    header @html_entries Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    header @html_entries Pragma "no-cache"
    header @html_entries Expires "0"

    # CamCam Pet primary viewer. Keep both '/' and '/pet' available; Android
    # intentionally uses /pet so stale edge caches on the historical root can
    # never send the legacy dashboard to the app.
    handle / {
        reverse_proxy pet:8020
    }

    @pet_entry path /pet /pet/
    handle @pet_entry {
        rewrite * /
        reverse_proxy pet:8020
    }

    # Serve the proven camera runtime directly. The previous iframe shell was
    # incompatible with our own CSP (frame-ancestors 'none') and could leave
    # the camera page blank, which in turn stopped WHIP publishing.
    handle /camera {
        rewrite * /static/pet_camera.html
        reverse_proxy api:8000
    }

    # Shared/owner-aware archive list and background talk wake signaling are
    # matched before the generic Pet API.
    @pet_recordings path_regexp pet_recordings ^/api/pet/devices/[^/]+/recordings$
    handle @pet_recordings {
        reverse_proxy petarchive:8030
    }

    @pet_talk_wake path_regexp pet_talk_wake ^/api/pet/devices/[^/]+/talk-wake$
    handle @pet_talk_wake {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/device/talk-wait {
        reverse_proxy petarchive:8030
    }

    handle /api/pet/* {
        reverse_proxy pet:8020
    }

    handle /pet-archive/* {
        reverse_proxy petarchive:8030
    }

    # Event highlight links use the historical /archive path; rewrite them to the
    # Pet archive gateway so family shares are authorized too.
    handle /archive/* {
        uri replace /archive /pet-archive
        reverse_proxy petarchive:8030
    }

    # Keep the legacy recording index available for older cached clients.
    @legacy_recordings path_regexp legacy_recording_list ^/api/devices/[^/]+/recordings$
    handle @legacy_recordings {
        reverse_proxy archive:8010
    }

    handle_path /webrtc/* {
        reverse_proxy mediamtx:8889
    }

    handle {
        reverse_proxy api:8000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    }
}
