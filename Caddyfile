camcam.smarbiz.sbs {
    encode zstd gzip

    @internal path /internal/*
    respond @internal 404

    @api path /api/*
    header @api Cache-Control "no-store, max-age=0"

    # Serve the viewer shell through the archive gateway so archive links stay
    # in the same tab/WebView instead of opening a popup that Android blocks.
    handle / {
        reverse_proxy archive:8010
    }

    # Camera shell is also passed through the gateway, which injects a safe
    # H264 preference for future recordings while keeping the original page.
    handle /camera {
        reverse_proxy archive:8010
    }

    # Only the recordings index is overridden. Ownership is still validated by
    # the main API and media bytes are proxied from MediaMTX's private playback server.
    @recordings path_regexp recording_list ^/api/devices/[^/]+/recordings$
    handle @recordings {
        reverse_proxy archive:8010
    }

    handle /archive/* {
        reverse_proxy archive:8010
    }

    handle_path /webrtc/* {
        reverse_proxy mediamtx:8889
    }

    handle {
        reverse_proxy api:8000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(self)"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
    }
}
